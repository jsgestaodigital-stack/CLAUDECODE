{
  "manifest_version": 3,
  "name": "AutoPoster TikTok Shop",
  "short_name": "AutoPoster",
  "version": "1.2.0",
  "description": "Posta automaticamente seus vídeos de afiliado no TikTok Studio, com produto vinculado e conteúdo de marca.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "unlimitedStorage", "alarms", "tabs", "scripting", "notifications", "offscreen", "power"],
  "host_permissions": [
    "https://www.tiktok.com/*",
    "https://vt.tiktok.com/*",
    "https://vm.tiktok.com/*",
    "https://shop.tiktok.com/*",
    "https://api.telegram.org/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Abrir painel do AutoPoster",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
